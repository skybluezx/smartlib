SMARTLIB_IMAGE_TAG=local
SMARTLIB_WEB_PORT=18080
SMARTLIB_WEB_DEMO_MODE=false
# Docker Hub 不可达时，可切换为组织批准的等价镜像源。
SMARTLIB_NODE_IMAGE=public.ecr.aws/docker/library/node:22-alpine
SMARTLIB_NGINX_IMAGE=public.ecr.aws/docker/library/nginx:1.28-alpine
SMARTLIB_POSTGRES_IMAGE=postgres:18.6-alpine
SMARTLIB_FLYWAY_IMAGE=flyway/flyway:13.0.0-alpine
SMARTLIB_PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.14.7-slim-bookworm
SMARTLIB_GO_IMAGE=public.ecr.aws/docker/library/golang:1.24.8-alpine
SMARTLIB_MINIO_RUNTIME_IMAGE=public.ecr.aws/docker/library/alpine:3.22
SMARTLIB_GO_PROXY=https://goproxy.cn,direct
# 可选：受限网络环境使用组织批准的 PyPI 镜像；默认仍为 https://pypi.org/simple。
SMARTLIB_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
SMARTLIB_OPENSEARCH_IMAGE=opensearchproject/opensearch:3.8.0
SMARTLIB_HUGEGRAPH_IMAGE=hugegraph/hugegraph:1.7.0
SMARTLIB_HUBBLE_IMAGE=hugegraph/hubble:1.7.0
SMARTLIB_MINIO_SOURCE_REF=7aac2a2c5b7c882e68c1ce017d8256be2feea27f
SMARTLIB_MINIO_IMAGE_TAG=7aac2a2

# 仅供本机开发；共享、演示生产或正式环境必须替换并使用密钥管理。
SMARTLIB_DB_NAME=smartlib
SMARTLIB_DB_BOOTSTRAP_USER=smartlib_bootstrap
SMARTLIB_DB_BOOTSTRAP_PASSWORD=REPLACE_WITH_UNIQUE_DB_BOOTSTRAP_PASSWORD
SMARTLIB_DB_API_PASSWORD=REPLACE_WITH_UNIQUE_DB_API_PASSWORD
SMARTLIB_DB_PROJECTION_PASSWORD=REPLACE_WITH_UNIQUE_DB_PROJECTION_PASSWORD
SMARTLIB_DEV_ACTOR_ID=00000000-0000-4000-8000-000000000001
SMARTLIB_ENVIRONMENT=development
SMARTLIB_API_PORT=18081
SMARTLIB_SEARCH_BACKEND=opensearch
SMARTLIB_SEARCH_PROJECTION_TARGET=opensearch
SMARTLIB_OPENSEARCH_URL=http://opensearch:9200
SMARTLIB_OPENSEARCH_INDEX_ALIAS=smartlib-knowledge-read
SMARTLIB_OPENSEARCH_WRITE_ALIAS=smartlib-knowledge-write
SMARTLIB_GRAPH_BACKEND=hugegraph
SMARTLIB_HUGEGRAPH_URL=http://hugegraph:8080
SMARTLIB_HUGEGRAPH_PORT=18082
SMARTLIB_HUBBLE_PORT=18088
SMARTLIB_HUGEGRAPH_USER=admin
SMARTLIB_HUGEGRAPH_PASSWORD=REPLACE_WITH_UNIQUE_HUGEGRAPH_PASSWORD
SMARTLIB_HUGEGRAPH_GRAPH=hugegraph
SMARTLIB_MINIO_API_PORT=19000
SMARTLIB_MINIO_CONSOLE_PORT=19001
SMARTLIB_MINIO_BROWSER_REDIRECT_URL=http://localhost:19001
SMARTLIB_MINIO_ROOT_USER=smartlib_minio
SMARTLIB_MINIO_ROOT_PASSWORD=REPLACE_WITH_UNIQUE_MINIO_ROOT_PASSWORD
SMARTLIB_S3_ENDPOINT_URL=http://minio:9000
SMARTLIB_S3_PUBLIC_ENDPOINT_URL=http://localhost:19000
SMARTLIB_S3_REGION=us-east-1
SMARTLIB_S3_BUCKET=smartlib-publications
SMARTLIB_REFERENCE_DATA_BUCKET=smartlib-reference-data
SMARTLIB_FULLTEXT_MAX_BYTES=104857600
SMARTLIB_BATCH_FULLTEXT_MAX_BYTES=367001600
# 本地历史全文预核验的只读来源目录；服务器部署时改为实际挂载路径。
SMARTLIB_ARCHIVE_FULLTEXT_SOURCE=/path/to/authorized-fulltexts
