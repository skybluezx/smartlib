[Unit]
Description=SmartLib authenticated public HTTPS gateway
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=notify
User=smartlib-gateway
Group=smartlib-gateway
ExecStart=/usr/local/lib/smartlib-public-gateway/caddy run --config /etc/smartlib-public-gateway/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
StateDirectory=smartlib-public-gateway
StateDirectoryMode=0700
WorkingDirectory=/var/lib/smartlib-public-gateway
Environment=XDG_DATA_HOME=/var/lib/smartlib-public-gateway/data
Environment=XDG_CONFIG_HOME=/var/lib/smartlib-public-gateway/config
Environment=GOMEMLIMIT=96MiB
Environment=GOMAXPROCS=2
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
UMask=0077
MemoryHigh=128M
MemoryMax=192M
TasksMax=64
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
